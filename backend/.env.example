# Copy to .env (gitignored). URL of the Python AI service (FastAPI).
AI_SERVICE_URL=http://localhost:8000

# Auth — JWT (constraint rule 6: secrets in env, never in source)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=1d

# Database (read by both database.module.ts runtime and data-source.ts CLI)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=dacn_db

# Admin salary rate (VND per hour)
# ADMIN_HOURLY_RATE=100000

# Optional: font dùng cho PDF report (mặc định tự dò Arial của Windows).
# Đặt nếu muốn font khác (phải là TTF có hỗ trợ tiếng Việt).
# AI_PDF_FONT=C:/Windows/Fonts/arial.ttf
# AI_PDF_FONT_BOLD=C:/Windows/Fonts/arialbd.ttf
